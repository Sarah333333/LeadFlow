# ── Required ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose to the browser
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                          # any long random string; protects /api/cron/follow-ups

# ── AI (optional: without it, a rule-based demo assistant runs) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── SMS (optional: without it, leads run in test mode) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                  # default sender, E.164 e.g. +353861234567

# ── Payments (optional until you charge) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=                 # price_… for $29/mo
STRIPE_PRICE_GROWTH=                  # price_… for $59/mo
STRIPE_PRICE_PRO=                     # price_… for $99/mo

# ── Email alerts to owners (optional) ──
RESEND_API_KEY=
EMAIL_FROM="LeadFlow AI <alerts@yourdomain.com>"

# ── Security / cost controls ──
SMS_ALLOWED_COUNTRY_CODES=+353,+44,+1   # only text these country codes (toll-fraud guard)
OPENAI_BASE_URL=                         # optional: proxy / gateway (leave empty for api.openai.com)
ALLOW_DEMO_AI=false                      # never let the rule-based demo bot talk to real customers in production
TRUSTED_IP_HEADER=x-forwarded-for         # header your platform sets with the real client IP (Vercel: x-forwarded-for, Cloudflare: cf-connecting-ip)
ADMIN_EMAILS=                            # LeadFlow operators allowed to see /internal/risk (comma-separated)
